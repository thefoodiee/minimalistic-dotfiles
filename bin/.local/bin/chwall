#!/usr/bin/env bash
# chwall - change wallpaper + generate colors using matugen
# Usage: chwall /path/to/image.jpg

set -euo pipefail

progname="$(basename "$0")"

usage() {
  cat <<EOF
Usage: $progname IMAGE

Change wallpaper, regenerate colors using matugen.

Example:
  $progname ~/Pictures/wall.jpg
EOF
  exit 1
}

[[ $# -ne 1 ]] && usage

IMAGE="$1"

if ! IMAGE_PATH="$(realpath -- "$IMAGE" 2>/dev/null)"; then
  echo "Error: cannot resolve path '$IMAGE'." >&2
  exit 2
fi

[[ -f "$IMAGE_PATH" ]] || {
  echo "Error: file not found: $IMAGE_PATH" >&2
  exit 3
}

command -v matugen >/dev/null || {
  echo "Error: 'matugen' not found."
  exit 4
}

echo "Generating colors..."
# matugen image "$IMAGE_PATH" --type scheme-fruit-salad --prefer less-saturation
# wallust run "$IMAGE_PATH" -q
wal -i "$IMAGE_PATH"

# --------------------------------------------------
# Save wallpaper to cache for hyprlock
# --------------------------------------------------

CACHE_DIR="$HOME/.cache/hyprlock"
WALLPAPER="$CACHE_DIR/wallpaper"
WALLPAPER_BLUR="$CACHE_DIR/wallpaper_blur"

mkdir -p "$CACHE_DIR"

cp -f "$IMAGE_PATH" "$WALLPAPER"

echo "Wallpaper cached at:"
echo "  $WALLPAPER"

# --------------------------------------------------
# Niri-specific blurred wallpaper
# --------------------------------------------------

if [[ "${XDG_CURRENT_DESKTOP:-}" == "niri" ]]; then
    command -v magick >/dev/null || {
        echo "Error: ImageMagick ('magick') not found."
        exit 5
    }

    command -v awww >/dev/null || {
        echo "Error: 'awww' not found."
        exit 6
    }

    echo "Creating blurred wallpaper..."
    magick "$IMAGE_PATH" \
        -blur 0x20 \
        "$WALLPAPER_BLUR"

    echo "Applying blurred wallpaper..."
    awww img \
        -n wallpaper \
        --transition-type center \
        --transition-fps 60 \
        "$WALLPAPER_BLUR"

    echo "Blurred wallpaper cached at:"
    echo "  $WALLPAPER_BLUR"
fi

# hooks
awww img --transition-type center --transition-fps 60 "$IMAGE_PATH"
gsettings set org.gnome.desktop.interface gtk-theme ""; gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark
pkill -USR2 btop || true
pkill -SIGUSR2 waybar &
pkill -x swaync && swaync &
pkill -x swayosd-server && swayosd-server &
