#!/usr/bin/env bash

WALLDIR="$HOME/Pictures/wallpapers"
CACHEDIR="$HOME/.cache/wallcache"
THEME="$HOME/.config/rofi/applets/wallSelect.rasi"
LAST="$CACHEDIR/last"

mkdir -p "$CACHEDIR"

# Generate 500x500 thumbnails
find "$WALLDIR" -maxdepth 1 -type f \
    \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) \
    -print0 |
while IFS= read -r -d '' file; do
    name="$(basename "$file")"
    cache="$CACHEDIR/$name"

    if [[ ! -f "$cache" || "$file" -nt "$cache" ]]; then
        magick "$file" \
            -resize '500x500^' \
            -gravity center \
            -extent 500x500 \
            "$cache"
    fi
done

# Build wallpaper list
mapfile -t wallpapers < <(
    find "$WALLDIR" -maxdepth 1 -type f \
        \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) \
        -printf '%f\n' |
    sort -V
)

# Determine previously selected row
selected_row=0

if [[ -f "$LAST" ]]; then
    last="$(<"$LAST")"

    for i in "${!wallpapers[@]}"; do
        if [[ "${wallpapers[$i]}" == "$last" ]]; then
            selected_row="$i"
            break
        fi
    done
fi

# Build Rofi menu
selected=$(
    for name in "${wallpapers[@]}"; do
        printf '%s\x00icon\x1f%s/%s\n' \
            "$name" "$CACHEDIR" "$name"
    done |
    rofi -i -show -dmenu \
        -theme "$THEME" \
        -selected-row "$selected_row"
)

# Save selection
if [[ -n "$selected" ]]; then
    printf '%s\n' "$selected" > "$LAST"
    ~/.local/bin/chwall "$WALLDIR/$selected"
fi
