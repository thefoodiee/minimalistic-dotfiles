layout {
	background-color "#191119"

    focus-ring {
        active-color "#bac3ff"
        inactive-color "#a08a9e"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bac3ff"
        inactive-color "#a08a9e"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#bac3ff"
        inactive-color "#a08a9e"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bac3ff80"
    }
}

overview {
	backdrop-color "#191119"
}

recent-windows {
    highlight {
        active-color "#bac3ff"
        urgent-color "#ffb4ab"
    }
}
