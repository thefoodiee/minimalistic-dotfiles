{
    "label" : "lock",
    "action" : "sh -c ~/.config/quickshell/lockscreen/lock.sh",
    "text" : "Lock [l]",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "sh -c 'if [ \"$XDG_CURRENT_DESKTOP\" = \"niri\" ]; then niri msg action quit; else hyprshutdown; fi'"
    "text" : "Logout [o]",
    "keybind" : "o"
}
{
    "label": "shutdown",
    "action": "sh -c 'if [ \"$XDG_CURRENT_DESKTOP\" = \"niri\" ]; then shutdown --now; else hyprshutdown --post-cmd \"shutdown -P 0\"; fi'",
    "text": "Shutdown [s]",
    "keybind": "s"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspend [u]",
    "keybind" : "u"
}
{
    "label": "reboot",
    "action": "sh -c 'if [ \"$XDG_CURRENT_DESKTOP\" = \"niri\" ]; then reboot; else hyprshutdown --post-cmd \"reboot\"; fi'",
    "text": "Reboot [r]",
    "keybind": "r"
}
{
  "label" : "hibernate",
  "action" : "systemctl hibernate",
  "text" : "Hibernate [h]",
  "keybind" : "h"
}
